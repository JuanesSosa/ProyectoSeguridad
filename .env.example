# Copia este archivo como ".env" (cp .env.example .env) y ajusta los valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Usuario de Docker Hub con el que se publican las imágenes (docker login)
DOCKERHUB_USER=tu_usuario_dockerhub

# Credenciales de PostgreSQL (cámbialas: no uses estos valores en producción)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=votacion
